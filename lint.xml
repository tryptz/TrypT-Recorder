<?xml version="1.0" encoding="UTF-8"?>
<!--
  Versions are pinned on purpose and upgraded together, as one toolchain
  change (AGENTS.md, "Versions"): Media3 1.11 needs a newer Kotlin than 2.1.0,
  and AGP, Kotlin and Gradle move as a set. "A newer version is available" is a
  reminder for that change, not a defect in whatever change is being linted,
  so it does not count against the zero-warning lint gate. Every other check
  stays on.
-->
<lint>
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
</lint>
