# Release signing for Tryptify Recorder. Copy to keystore.properties in this
# directory (gitignored) and fill in. A relative storeFile resolves against
# recorder/; keeping the .jks outside the repository is safer.
#
# This is the recorder's own key, separate from Tryptify's (the root
# keystore.properties). Every update must be signed with the same key as the
# build already installed, so the .jks and its password must never be lost.
storeFile=/path/outside/the/repo/tryptify-recorder-release.jks
storePassword=your-store-password
keyAlias=tryptify-recorder
keyPassword=same-as-storePassword
